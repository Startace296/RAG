PDF_PATH=data

EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DOCUMENT_PREFIX="passage: "
EMBEDDING_QUERY_PREFIX="query: "

CHUNKING_STRATEGY=recursive
CHUNK_SIZE=300
CHUNK_OVERLAP=50
MIN_CHUNK_SIZE=50

VECTOR_INDEX_TYPE=flat
VECTOR_BENCHMARK_INDEXES=flat,hnsw,ivf
FAISS_HNSW_M=32
FAISS_IVF_NLIST=64
FAISS_IVF_NPROBE=8

TOP_K=5
# Depends on the embedding model: e5 scores cluster around 0.77-0.92, MiniLM needs about 0.25.
SIMILARITY_THRESHOLD=0.795
MAX_CONTEXT_CHARS=12000

LOCAL_LLM_MODEL=Qwen/Qwen3-0.6B
MAX_NEW_TOKENS=512
# QWEN_TEMPERATURE, QWEN_TOP_P and QWEN_TOP_K only apply when QWEN_DO_SAMPLE=true.
QWEN_DO_SAMPLE=false
QWEN_TEMPERATURE=0.3
QWEN_TOP_P=0.8
QWEN_TOP_K=20
QWEN_REPETITION_PENALTY=1.1
QWEN_ENABLE_THINKING=false

DOCUMENT_IMAGE_EXPORT=true
DOCUMENT_IMAGE_OCR=false
IMAGE_OUTPUT_DIR=storage/images
# Images smaller than this many pixels on either side are skipped.
IMAGE_MIN_SIDE=32
RAG_VERBOSE=false

# Question file used by the benchmark scripts. It must match the PDF above.
EVALUATION_QUESTIONS=evaluation/kinhtevn_questions.jsonl
EMBEDDING_BENCHMARK_MODELS=miniLM-multilingual,mpnet-multilingual,e5-small,e5-base
