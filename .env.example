PDF_PATH=data

EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DOCUMENT_PREFIX="passage: "
EMBEDDING_QUERY_PREFIX="query: "
# Keep the embedder on CPU so the LLM has the whole GPU (set to cuda to override).
EMBEDDING_DEVICE=cpu

CHUNKING_STRATEGY=recursive
CHUNK_SIZE=300
CHUNK_OVERLAP=50
MIN_CHUNK_SIZE=50

VECTOR_INDEX_TYPE=flat
VECTOR_BENCHMARK_INDEXES=flat,hnsw,ivf
FAISS_HNSW_M=32
FAISS_IVF_NLIST=64
FAISS_IVF_NPROBE=8

TOP_K=5
# hybrid: re-rank the dense candidates with BM25 keyword ranks (Reciprocal Rank Fusion); dense: FAISS only.
RETRIEVAL_MODE=hybrid
# Number of dense candidates re-ranked (by BM25 in hybrid mode and/or by the reranker).
HYBRID_CANDIDATES=10
HYBRID_RRF_K=60
# Cross-encoder that gives the final order of the candidates (empty disables it).
# Runs on CPU by default so the LLM keeps the GPU. A local folder (relative to the project) also works,
# e.g. storage/models/bge-reranker-v2-m3 when the Hugging Face cache drive is full.
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=cpu
# Depends on the embedding model: e5 scores cluster around 0.77-0.92, MiniLM needs about 0.25.
SIMILARITY_THRESHOLD=0.795
MAX_CONTEXT_CHARS=12000

LOCAL_LLM_MODEL=Qwen/Qwen3-4B-Instruct-2507
# Load weights in 4-bit (needs CUDA torch + bitsandbytes); fits a 4GB GPU.
LLM_LOAD_IN_4BIT=true
# Split the prompt prefill into chunks of this many tokens to keep VRAM low (0 disables).
LLM_PREFILL_CHUNK_SIZE=512
MAX_NEW_TOKENS=512
# QWEN_TEMPERATURE, QWEN_TOP_P and QWEN_TOP_K only apply when QWEN_DO_SAMPLE=true.
QWEN_DO_SAMPLE=false
QWEN_TEMPERATURE=0.3
QWEN_TOP_P=0.8
QWEN_TOP_K=20
QWEN_REPETITION_PENALTY=1.0
# Only used by hybrid Qwen3 models (e.g. Qwen3-0.6B); Instruct-2507 never thinks.
QWEN_ENABLE_THINKING=false

# Remove running headers/footers and page numbers before chunking.
DOCUMENT_STRIP_BOILERPLATE=true
DOCUMENT_IMAGE_EXPORT=true
DOCUMENT_IMAGE_OCR=false
IMAGE_OUTPUT_DIR=storage/images
# Images smaller than this many pixels on either side are skipped.
IMAGE_MIN_SIDE=32
RAG_VERBOSE=false

# Question file used by the benchmark scripts. It must match the PDF above.
EVALUATION_QUESTIONS=evaluation/kinhtevn_questions.jsonl
EMBEDDING_BENCHMARK_MODELS=miniLM-multilingual,mpnet-multilingual,e5-small,e5-base
